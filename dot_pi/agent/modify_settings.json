#!/bin/sh
# chezmoi modify script for ~/.pi/agent/settings.json: chezmoi sends the current
# file on stdin and writes stdout back. This repo owns the keys in $ours and
# they win. Keys pi writes itself and the repo leaves out (deviceId,
# lastChangelogVersion) stay from the current file. Objects merge key by key;
# arrays from $ours replace the current ones.
set -eu

# ── Settings this repo owns ───────────────────────────────────────────────────
ours=$(
	cat <<'EOF'
{
  "theme": "dark",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-footer",
    "npm:pi-context-view",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "skills": [
    "~/.claude/skills",
    "!../../.claude/skills/synced/**"
  ],
  "extensions": [
    "~/.claude/hooks/enforce-cli-tools/pi.ts"
  ],
  "enabledModels": [
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/deepseek/deepseek-v4-pro",
    "openrouter/moonshotai/kimi-k3",
    "openai/gpt-6.1-sol"
  ]
}
EOF
)

# ── Merge over the current file ───────────────────────────────────────────────
# Empty stdin (no ~/.pi/agent/settings.json yet) reads as {}.
# Remove the retired pi-powerline-footer settings.
jq -n --argjson ours "$ours" '(((try input catch {}) // {}) * $ours) | del(.powerline)'
