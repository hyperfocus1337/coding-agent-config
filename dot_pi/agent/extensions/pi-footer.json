{
  "version": 1,
  "enabled": true,
  "preset": "powerline-mono",
  "separator": "none",
  "iconMode": "nerd",
  "extensionStatusRow": {
    "hiddenKeys": ["codex-session", "codex-weekly"]
  },
  "terminal": {
    "widthMode": "full",
    "colorLevel": "ansi256"
  },
  "lines": [
    [
      {
        "id": "cwd",
        "type": "cwd",
        "options": {
          "raw": true,
          "cwdDisplayStyle": "full-home",
          "fg": "brightWhite",
          "bg": "ansi256:240"
        }
      },
      {
        "id": "cwd-branch-separator",
        "type": "separator",
        "options": {
          "separator": "powerline-right-spaced",
          "fg": "ansi256:240",
          "bg": "ansi256:250"
        }
      },
      {
        "id": "branch",
        "type": "git-branch",
        "options": {
          "fg": "black",
          "bg": "ansi256:250"
        }
      },
      {
        "id": "branch-diff-separator",
        "type": "separator",
        "options": {
          "separator": "powerline-right-spaced",
          "fg": "ansi256:250",
          "bg": "ansi256:233"
        }
      },
      {
        "id": "diff",
        "type": "git-diff",
        "options": {
          "raw": true,
          "gitDiffMode": "compact",
          "fg": "brightWhite",
          "bg": "ansi256:233"
        }
      }
    ],
    [
      {
        "id": "remote",
        "type": "git-remote",
        "options": {
          "raw": true,
          "hideWhenEmpty": false,
          "fg": "black",
          "bg": "ansi256:250"
        }
      }
    ],
    [
      {
        "id": "context",
        "type": "context-bar",
        "options": {
          "raw": true,
          "contextBarMode": "medium",
          "tokenFormatStyle": "compact",
          "fg": "black",
          "bg": "ansi256:252"
        }
      },
      {
        "id": "context-session-separator",
        "type": "separator",
        "options": {
          "separator": "powerline-right-spaced",
          "fg": "ansi256:252",
          "bg": "ansi256:240"
        }
      },
      {
        "id": "codex-session",
        "type": "external-status",
        "options": {
          "raw": true,
          "externalStatusKey": "codex-session",
          "hideWhenEmpty": true,
          "trimValue": 8,
          "fg": "brightWhite",
          "bg": "ansi256:240"
        }
      },
      {
        "id": "session-weekly-separator",
        "type": "separator",
        "options": {
          "separator": "powerline-right-spaced",
          "fg": "ansi256:240",
          "bg": "ansi256:250"
        }
      },
      {
        "id": "codex-weekly",
        "type": "external-status",
        "options": {
          "raw": true,
          "externalStatusKey": "codex-weekly",
          "hideWhenEmpty": true,
          "trimValue": 7,
          "fg": "black",
          "bg": "ansi256:250"
        }
      },
      {
        "id": "weekly-model-separator",
        "type": "separator",
        "options": {
          "separator": "powerline-right-spaced",
          "fg": "ansi256:250",
          "bg": "ansi256:240"
        }
      },
      {
        "id": "model-provider",
        "type": "model-provider",
        "options": {
          "raw": true,
          "fg": "brightWhite",
          "bg": "ansi256:240"
        }
      }
    ]
  ]
}
