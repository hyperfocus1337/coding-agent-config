{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Docs: ../docs/research/context/disabled-tools.md",
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "SendFeedback",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableRemoteControl": false,
  "disableWorkflows": true,
  "disableArtifact": true
}
