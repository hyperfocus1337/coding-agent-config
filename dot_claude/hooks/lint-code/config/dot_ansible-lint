# Relaxed ansible-lint config for Ansible YAML.
# The hook uses this fallback only when no project configuration exists.
# Edit here to change the fallback policy.
#
# The hook passes the sibling .yamllint, or the project .yamllint, with
# --yamllint-file, so ~/.config/yamllint/config cannot change the result.
# skip_list silences the indentation and line-length findings of that
# yamllint config entirely (no output, non-blocking).

# To downgrade from fatal (blocks the edit) to warnings (printed, non-blocking)
# instead of silencing, use warn_list:
#warn_list:
#  - yaml[indentation]
#  - yaml[line-length]

skip_list:
  - yaml[indentation]
  - yaml[line-length]
