{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "The install-bootstrap skill merges this file into a repo's .claude/settings.json. Do not change the hook object: the merge matches it by value. Docs: ../SKILL.md",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "curl -fsSL https://raw.githubusercontent.com/hyperfocus1337/coding-agent-config/main/templates/web/bootstrap.sh | bash"
          }
        ]
      }
    ]
  }
}
