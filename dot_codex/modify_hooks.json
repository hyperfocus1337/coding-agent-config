#!/bin/sh
# chezmoi modify script for ~/.codex/hooks.json: chezmoi sends the current file
# on stdin and writes stdout back. This repo owns the hooks in $ours.
# `cmux hooks codex install` owns the cmux handlers: their script names carry a
# content hash that changes with cmux releases, so they are kept from the
# current file, not tracked here. They are kept only where ~/.cmux/hooks
# exists, so the devcontainer gets none.
set -eu

# ── cmux handlers ─────────────────────────────────────────────────────────────
keep_cmux=false
[ -d "$HOME/.cmux/hooks" ] && keep_cmux=true

# ── Hooks this repo owns ──────────────────────────────────────────────────────
ours=$(cat <<'EOF'
{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/format-all-languages/command.ts\"",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/format-org-tables/command.ts\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/lint-all-languages/command.ts\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/track-session-changes/hook.ts\" codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.codex/hooks/apply-patch.ts\" \"$HOME/.claude/hooks/format-all-languages/command.ts\"",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.codex/hooks/apply-patch.ts\" \"$HOME/.claude/hooks/format-org-tables/command.ts\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.codex/hooks/apply-patch.ts\" \"$HOME/.claude/hooks/lint-all-languages/command.ts\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.codex/hooks/apply-patch.sh\" \"$HOME/.claude/hooks/lint-prose/hook.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/track-session-changes/hook.ts\" codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$HOME/.claude/hooks/block-secret-commits/guard.sh\"",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/enforce-cli-tools/command.ts\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/track-session-changes/hook.ts\" codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/track-session-changes/hook.ts\" codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "case $(node -p process.features.typescript 2>/dev/null) in strip | transform) ;; *) echo '{\"systemMessage\": \"Node 23.6 or later is not on the PATH of Codex, so enforce-cli-tools, lint-all-languages, format-all-languages, format-org-tables, and track-session-changes are off, block-secret-commits blocks each git commit, and git does not format staged files. Put node 23.6 or later on the PATH, then start a new session.\"}' ;; esac",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "command -v node >/dev/null || exit 0; NODE_COMPILE_CACHE=\"$HOME/.cache/node-compile-cache\" node \"$HOME/.claude/hooks/track-session-changes/hook.ts\" codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/type-check-all-languages/hook.sh\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
EOF
)

# ── Merge over the current file ───────────────────────────────────────────────
# Empty stdin (no ~/.codex/hooks.json yet) reads as {}. A group is cmux's when
# every handler in it runs a script from ~/.cmux/hooks.
jq -n --argjson ours "$ours" --argjson keep_cmux "$keep_cmux" '
  def cmux_group:
    .hooks | length > 0 and all((.command // "") | test("/\\.cmux/hooks/cmux-codex-hook-"));
  ((try input catch {}) // {} | .hooks // {}) as $current
  | if $keep_cmux then
      reduce ($current | to_entries[]) as $event ($ours;
        ($event.value | map(select(cmux_group))) as $groups
        | if $groups == [] then . else .hooks[$event.key] += $groups end)
    else $ours end
'
